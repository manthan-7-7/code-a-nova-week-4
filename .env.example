# ShieldML Environment Configuration

# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false
LOG_LEVEL=INFO

# Machine Learning & Artifacts
ARTIFACTS_DIR=artifacts
DATA_DIR=data
CHAMPION_MODEL_PATH=artifacts/champion_model.joblib
PREPROCESSOR_PATH=artifacts/preprocessor.joblib
METADATA_PATH=artifacts/metadata.json

# Threshold Override (Optional, defaults to trained F2-optimal threshold in metadata)
DECISION_THRESHOLD_OVERRIDE=

# MLflow Tracking
MLFLOW_TRACKING_URI=file:./mlruns
MLFLOW_EXPERIMENT_NAME=ShieldML-Fraud-Detection
MLFLOW_REGISTERED_MODEL_NAME=ShieldML-Champion

# SLA & Monitoring Targets
TARGET_LATENCY_MS=50.0
MONITORING_WINDOW_SIZE=1000

# CORS
CORS_ORIGINS=*
